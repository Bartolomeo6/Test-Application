<Window x:Class="test_Menu.AddQuestion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:test_Menu"
        mc:Ignorable="d"
        Title="Add Question Field" Height="450" Width="800">
    <StackPanel>
        <TextBox x:Name="newQuestField" FontSize="50"></TextBox>
        <Button Click="AddingQuestButton_Click" FontSize="40">Add your question</Button>
        <Label>The Answer to this Question is: </Label>
        <RadioButton x:Name="ansYes" FontSize="50">Yes</RadioButton>
        <RadioButton x:Name="ansNo" FontSize="50">No</RadioButton>
    </StackPanel>
</Window>
