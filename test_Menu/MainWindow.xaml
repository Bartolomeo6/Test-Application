<Window x:Class="test_Menu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:test_Menu"
        mc:Ignorable="d"
        Title="Test App done by ..." Height="300" Width="900">
    <UniformGrid Background="CadetBlue">
        <Button Margin="20" Background="Beige" Foreground="Orange" FontFamily="Verdana" FontSize="20" FontWeight="Black" BorderBrush="AliceBlue" BorderThickness="5" Click="EnteringTheTest">Enter Test</Button>
        <Button Margin="20" Background="Beige" Foreground="Orange" FontFamily="Verdana" FontSize="20" FontWeight="Black" BorderBrush="AliceBlue" BorderThickness="5" Click="AddTheNewQuestion">Add new Question</Button>
    </UniformGrid>
</Window>
